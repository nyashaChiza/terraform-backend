# ─────────────────────────────────────────────────────────────────────────────
# Terraform Backend — Environment Variables
#
# LOCAL DEVELOPMENT
#   Copy this file to .env and fill in the values.
#   .env is gitignored and never deployed.
#
# PRODUCTION (Vercel)
#   Set each variable in the Vercel project dashboard under
#   Settings → Environment Variables. The .env file is NOT used on Vercel.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Terraform
ENV=development          # change to "production" on Vercel
DEBUG=False

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
REFRESH_SECRET_KEY=change-me-to-another-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=5000
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_ACTION_KEY=change-me

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev  → SQLite (no setup needed)
DATABASE_URL=sqlite:///./terraform_dev.db

# Production → Neon PostgreSQL (set this in Vercel env vars, NOT here)
# DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# ── AI APIs ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Cloudinary (profile picture storage) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
